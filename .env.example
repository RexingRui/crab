# 服务
ENV=prod                          # dev / prod
HTTP_ADDR=:8080
LOG_LEVEL=info

# 数据库
DB_PATH=./data/crab.db

# 微信小程序
WECHAT_APPID=wx1234567890abcdef
WECHAT_SECRET=

# 鉴权
AUTH_SECRET=                      # 必填，至少 32 字符随机串：openssl rand -hex 32
AUTH_TOKEN_TTL=720h
ADMIN_OPENIDS=                    # 逗号分隔；为空时启用引导模式

# 业务
TIMEZONE=Asia/Shanghai
PUBLIC_RATE_LIMIT=20              # 每 IP 每分钟
