# 注意：这个文件的解析器很朴素（internal/config.loadDotEnv），
# 行尾不要写注释，KEY=VALUE 后面的东西都会被当成值的一部分。

# 服务
# ENV: dev / prod。dev 不校验 WECHAT_SECRET 并开启 CORS
ENV=prod
# HTTP_ADDR: 裸机部署建议 127.0.0.1:8080（由反代负责 HTTPS）；
# Docker 部署会被 compose 强制覆盖成 :8080，这里写什么都不影响
HTTP_ADDR=:8080
# LOG_LEVEL: debug / info / warn / error
LOG_LEVEL=info

# 数据库
# Docker 部署会被 compose 强制覆盖成 /data/crab.db
DB_PATH=./data/crab.db

# 微信小程序
WECHAT_APPID=wx1234567890abcdef
WECHAT_SECRET=

# 鉴权
# AUTH_SECRET: 必填，至少 32 字符随机串
#   echo "AUTH_SECRET=$(openssl rand -hex 32)" >> .env
AUTH_SECRET=
AUTH_TOKEN_TTL=720h
# ADMIN_OPENIDS: 逗号分隔；为空时启用引导模式（/api/login 不校验白名单）
ADMIN_OPENIDS=

# 业务
TIMEZONE=Asia/Shanghai
# PUBLIC_RATE_LIMIT: 买家查单接口每 IP 每分钟的次数上限
PUBLIC_RATE_LIMIT=20

# ---------- 以下仅 Docker 部署用到，被 docker compose 读取 ----------
# CRAB_DOMAIN: 只有启用容器化 Caddy（--profile proxy）时必填，
#   必须是已解析到本机、已备案的域名，Caddy 会自动申请 HTTPS 证书
CRAB_DOMAIN=
# GOPROXY: 构建镜像时拉 Go 依赖用。国内机器建议 https://goproxy.cn,direct
GOPROXY=https://proxy.golang.org,direct
