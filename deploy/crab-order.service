[Unit]
Description=Crab Order Management API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=crab
Group=crab
WorkingDirectory=/opt/crab-order
EnvironmentFile=/opt/crab-order/.env
ExecStart=/opt/crab-order/bin/crab-server
Restart=always
RestartSec=3

# 只监听 127.0.0.1:8080，由 Caddy / Nginx 反代并负责 HTTPS 证书
# 因此不需要 CAP_NET_BIND_SERVICE

# 加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/crab-order/data

StandardOutput=journal
StandardError=journal
SyslogIdentifier=crab-order

[Install]
WantedBy=multi-user.target
