{
  "name": "crab-note",
  "version": "0.1.0",
  "private": true,
  "description": "蟹记 — 个人记录工具（Taro + React 小程序端）",
  "templateInfo": {
    "name": "default",
    "typescript": false,
    "css": "sass",
    "framework": "react"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "build:h5": "taro build --type h5",
    "dev:h5": "npm run build:h5 -- --watch",
    "ci:preview": "node scripts/mp-ci.js preview",
    "ci:upload": "node scripts/mp-ci.js upload",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "browserslist": {
    "production": [
      "defaults and fully supports es6-module",
      "maintained node versions"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/router": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-react": "^7.29.7",
    "@tarojs/cli": "4.2.1",
    "@tarojs/plugin-platform-h5": "^4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "babel-preset-taro": "4.2.1",
    "miniprogram-ci": "^2.1.31",
    "postcss": "^8.4.38",
    "sass": "^1.77.0",
    "vitest": "^2.1.8",
    "webpack": "~5.91.0"
  }
}
