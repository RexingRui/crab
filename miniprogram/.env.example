# 构建 / 部署用的环境变量。复制成 .env 自己填，.env 不进仓库。
# 正式的 appid 和域名已经写在 project.config.json 和 src/utils/config.js 里，
# 下面这些只在「想覆盖默认值」或「本机手动上传」时才需要。

# 构建期注入（覆盖 src/utils/config.js 里的正式域名，指向测试环境时用）
# TARO_APP_API_BASE_URL=
# TARO_APP_TRACK_URL=

# 上传用（只在本机 / CI 环境里，不写进包）
# WX_APPID=wx16ca0ed61d257288                  # 留空则取 project.config.json 里的
WX_PRIVATE_KEY_PATH=./private.wx16ca0ed61d257288.key  # 相对 miniprogram/ 目录；后台「开发管理 → 开发设置 → 上传密钥」下载
# WX_PRIVATE_KEY=                              # 或直接给密钥内容，CI 里用这个
WX_CI_ROBOT=1                                  # CI 机器人编号 1-30
# MP_VERSION=0.1.1                             # 留空则取 package.json 的 version
# MP_DESC=                                     # 留空则用「版本号 @ 提交号」
