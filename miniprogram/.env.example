# 构建 / 部署用的环境变量。复制成 .env 自己填，.env 不进仓库。
# CI 里对应仓库 Variables（域名）和 Secrets（AppID、上传密钥）。

# 构建期注入（写进包里）
TARO_APP_API_BASE_URL=https://crab.example.com   # 接口域名，同时要配成小程序 request 合法域名
TARO_APP_TRACK_URL=https://crab.example.com      # 买家查单页域名

# 上传用（只在本机 / CI 环境里，不写进包）
WX_APPID=wx1234567890abcdef
WX_PRIVATE_KEY_PATH=./private.wx1234567890abcdef.key  # 相对 miniprogram/ 目录；后台「开发管理 → 开发设置 → 上传密钥」下载
# WX_PRIVATE_KEY=                                # 或直接给密钥内容，CI 里用这个
WX_CI_ROBOT=1                                    # CI 机器人编号 1-30
# MP_VERSION=0.1.1                               # 留空则取 package.json 的 version
# MP_DESC=                                       # 留空则用「版本号 @ 提交号」
